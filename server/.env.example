# ==========================================
# ENTERPRISE SOFTWARE INVENTORY REGISTRY
# Server Environment Variables Template
# ==========================================

# Database Connection
# Local Development (SQLite - Zero installation required):
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL - Render / Neon / Supabase / AWS RDS):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/enterprise_inventory?schema=public"

# Server Port
PORT=5000
NODE_ENV=development

# JWT Secret & Expiry
JWT_SECRET="enterprise_super_secret_jwt_key_2026_secure"
JWT_EXPIRES_IN="7d"

# Allowed Client Origin (for CORS)
CLIENT_URL="http://localhost:5173"

# Default Seed Administrator Credentials
ADMIN_EMAIL="admin@enterprise.internal"
ADMIN_PASSWORD="Admin@123456"
ADMIN_NAME="Enterprise System Administrator"
